ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. When BOTH are set, every request requires HTTP Basic Auth.
# Leave them unset locally if you don't want a login prompt during dev.
BASIC_AUTH_USER=clapstore
BASIC_AUTH_PASS=change-me

# Optional. Set to "1" to dump every parsed PO to debug-po.txt (local-only debugging).
PO_DEBUG_DUMP=0
